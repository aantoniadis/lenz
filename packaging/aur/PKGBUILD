# AUR package `lenz-bin`: the prebuilt release tarball. packaging/bump.sh fills in pkgver and the checksums.
pkgname=lenz-bin
pkgver=0.0.1
pkgrel=1
pkgdesc="Side-by-side diff viewer, Git client and merge tool with GUI and terminal frontends"
arch=('x86_64' 'aarch64')
url="https://github.com/aantoniadis/lenz"
license=('MIT' 'Apache-2.0')
# vulkan-icd-loader: the GUI renders through Vulkan; wayland, libxcb and libxkbcommon are loaded at runtime for the display
depends=('git' 'glibc' 'gcc-libs' 'vulkan-icd-loader' 'wayland' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11')
optdepends=('github-cli: browse and review GitHub pull requests')
provides=('lenz')
conflicts=('lenz')
options=('!debug' '!strip')
source_x86_64=("$url/releases/download/v$pkgver/lenz-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/lenz-$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('3c30465acfb931c504947695f5090aa45dc68a69d0a4e42bcabd527e4891d7c3')
sha256sums_aarch64=('492fb85ec187d27631ee77f8b7b5652b36d170d1a497e143a7047690106c03a6')

package() {
  cd "lenz-$pkgver-$CARCH-unknown-linux-gnu"
  install -Dm755 lenz "$pkgdir/usr/bin/lenz"
  install -Dm755 lenz-tui "$pkgdir/usr/bin/lenz-tui"
  install -Dm644 lenz.desktop "$pkgdir/usr/share/applications/lenz.desktop"
  # one 1024 px PNG: pixmaps is the size-independent location the icon lookup always searches
  install -Dm644 lenz-icon.png "$pkgdir/usr/share/pixmaps/lenz.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/lenz/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/lenz/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/lenz/LICENSE-APACHE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/lenz/NOTICE"
}
